# =====================================================================
# SHIVNATH AGENCY BACKEND CONFIGURATION
# =====================================================================

# Security
DEBUG=False
SECRET_KEY=your-production-secret-key-here-generate-random-string

# Allowed Hosts (comma-separated for production)
ALLOWED_HOSTS=api.yourdomain.com,shivnath-agency.onrender.com,localhost,127.0.0.1

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://shivnath-agency.onrender.com

# Database Connection (Use DATABASE_URL for Render / Railway / Heroku)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Or individual DB fields for standard PostgreSQL:
# DB_NAME=shivnath_agency
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# Razorpay Online Payment Gateway (Production / Live Credentials)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_ENVIRONMENT=live

# Firebase Cloud Messaging (FCM) Configuration
# Option 1 (Render Production): Single raw JSON string from Service Account key
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option 2 (Local Development): Path to renamed/local Service Account key JSON file
# FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# SSL / HTTPS (Set to True in production behind SSL reverse proxy)
SECURE_SSL_REDIRECT=False

