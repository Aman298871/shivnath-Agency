# =====================================================================
# SHIVNATH AGENCY BACKEND CONFIGURATION
# =====================================================================

# Security
DEBUG=False
SECRET_KEY=your-production-secret-key-here-generate-random-string

# Allowed Hosts (comma-separated for production)
ALLOWED_HOSTS=api.yourdomain.com,your-app.onrender.com,localhost,127.0.0.1

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# Database Connection (Use DATABASE_URL for Render / Railway / Heroku)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Or individual DB fields for standard PostgreSQL:
# DB_NAME=shivnath_agency
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# SSL / HTTPS (Set to True in production behind SSL reverse proxy)
SECURE_SSL_REDIRECT=False
