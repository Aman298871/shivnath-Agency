# =====================================================================
# SHIVNATH AGENCY - DEDICATED RAZORPAY TEST ENVIRONMENT CONFIGURATION
# =====================================================================
ENVIRONMENT=test
DEBUG=True
USE_SQLITE=1
SECRET_KEY=shivnath-agency-test-key-2026-secure-isolated-environment

# Allowed Hosts for Local Test Backend (Emulator, Device, Localhost)
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2,192.168.1.9,*

# Razorpay Test Gateway Configuration
# IMPORTANT: Enter genuine Razorpay Test Mode credentials from https://dashboard.razorpay.com/app/keys
# Test keys strictly start with 'rzp_test_'
# Mock payment mode is strictly prohibited. Production credentials belong strictly in Render environment settings.
RAZORPAY_ENVIRONMENT=TEST
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
