# ==============================================================================
# WATER WALA - REACT WEB ADMIN ENVIRONMENT CONFIGURATION
# ==============================================================================

# In development (npm run dev):
# Leave VITE_API_BASE_URL blank so requests go through Vite's dev proxy, eliminating CORS errors completely.
VITE_API_BASE_URL=

# Backend target for the dev proxy (switch between cloud and local as needed):
VITE_BACKEND_TARGET=https://api.shivnathagencies.com
# VITE_BACKEND_TARGET=http://127.0.0.1:8000
